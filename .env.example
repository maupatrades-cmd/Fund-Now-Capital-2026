# Supabase — client-safe values (the anon key is protected by RLS and is meant
# to be exposed in the browser). Copy this file to .env and fill in real values.
# NEVER put the Supabase service_role key here — it must never reach the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side secrets (Edge Functions only — NEVER read by the browser) ---
# RESEND_API_KEY is used by the send-notification-email Edge Function (A12).
# In production it is set as a Supabase Edge Function secret (dashboard), NOT here.
# For local function testing, put the real key in .env.local (gitignored).
RESEND_API_KEY=re_xxx_your_key_here
