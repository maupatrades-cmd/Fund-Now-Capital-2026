# Supabase — client-safe values (the anon key is protected by RLS and is meant
# to be exposed in the browser). Copy this file to .env and fill in real values.
# NEVER put the Supabase service_role key here — it must never reach the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
